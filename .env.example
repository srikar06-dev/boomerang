# Copy to .env (install.sh does it) and fill in. NEVER commit .env.

# --- AWS: use ONE of the two options ---
AWS_REGION=us-east-2
# Option A (preferred): a named profile in ~/.aws/credentials, e.g. [boomerang]
AWS_PROFILE=
# Option B: keys directly (leave AWS_PROFILE empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
BEDROCK_FALLBACK_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
GEMINI_API_KEY=

MONGODB_URI=
MONGODB_DB=returniq

# install.sh fills this with a random value
LINK_SIGNING_SECRET=

# Shared staff key for ship-out, review and seed (X-Station-Key header). Same value on every laptop.
# Generate once:  python -c "import secrets; print(secrets.token_hex(24))"  and share it by private DM.
STATION_KEY=

# 1 = allow POST /seed, which WIPES the demo collections. Only on the demo backend laptop.
DEMO_MODE=0

# --- Counter station ---
API_URL=http://localhost:8000
SERIAL_PORT=/dev/ttyACM0
# Mac example: SERIAL_PORT=/dev/cu.usbmodem1101
